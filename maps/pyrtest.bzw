# Minimal isolation test: nothing but the 5-pyramid "support" cluster from
# hix.bzw's diag_quadrant, moved to the world origin. Load this same file in
# bzo and in real bzflag/bzfs and compare the support struts directly --
# no walkways, no tower, no other geometry to obscure which way the cap
# pieces point.

world
	size 200
end

material
	name strut
	addtexture http://images.bzflag.org/bz_legacy/louman/thegauntlet/Metal5.png
end

pyramid
	name sup_in_core
	position 0.0 0.0 0.0
	rotation 45.0
	size     2.0 2.0 18.0
	sides matref strut
end
pyramid
	name sup_in_rib0
	position 0.0 0.0 0.0
	rotation 0.0
	size     8.0 1.0 5.0
	sides matref strut
end
pyramid
	name sup_in_rib90
	position 0.0 0.0 0.0
	rotation 90.0
	size     8.0 1.0 5.0
	sides matref strut
end
pyramid
	name sup_in_cap0
	position 0.0 0.0 12.0
	rotation 0.0
	size     8.0 -0.5 -2.0
	sides matref strut
end
pyramid
	name sup_in_cap90
	position 0.0 0.0 12.0
	rotation 90.0
	size     8.0 -0.5 -2.0
	sides matref strut
end
